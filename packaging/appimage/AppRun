#!/bin/sh

# CPU Switch Control - ponto de entrada do AppImage.
#
# Configura os caminhos internos do AppImage, carrega hooks de runtime do GTK e
# sincroniza o daemon/systemd com o sistema quando necessário.

set -eu

# APPDIR é fornecido pelo runtime AppImage; o fallback facilita testes do AppDir.
if [ -n "${APPDIR:-}" ]; then
    APPROOT="$APPDIR"
else
    APPROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
fi

export CPU_SWITCH_APPDIR="$APPROOT"
export PATH="$APPROOT/usr/bin:${PATH:-/usr/bin:/bin}"

# Acrescenta diretórios somente quando existem, evitando entradas inválidas no loader.
prepend_library_path() {
    directory="$1"
    [ -d "$directory" ] || return 0
    if [ -n "${LD_LIBRARY_PATH:-}" ]; then
        LD_LIBRARY_PATH="$directory:$LD_LIBRARY_PATH"
    else
        LD_LIBRARY_PATH="$directory"
    fi
}

prepend_library_path "$APPROOT/usr/lib"
prepend_library_path "$APPROOT/usr/lib/x86_64-linux-gnu"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"

# GTK procura schemas, ícones e outros dados pelo XDG_DATA_DIRS.
export XDG_DATA_DIRS="$APPROOT/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# linuxdeploy plugins (notably the GTK plugin) install runtime environment hooks here.
# Plugins do linuxdeploy podem deixar hooks para preparar GTK antes de iniciar a GUI.
if [ -d "$APPROOT/apprun-hooks" ]; then
    for hook in "$APPROOT"/apprun-hooks/*; do
        [ -f "$hook" ] || continue
        # shellcheck disable=SC1090
        . "$hook"
    done
fi

# O script abaixo faz staging fora do mount FUSE antes de usar pkexec.
# Falhas não impedem a abertura da GUI; ela também consegue tentar reparar o
# serviço novamente quando o usuário solicita "Salvar e reiniciar serviço".
if [ "${CPU_SWITCH_SKIP_SYSTEM_SETUP:-0}" != "1" ] &&
   [ -d /run/systemd/system ]; then
    "$APPROOT/usr/lib/cpu-switch-control/ensure-system-components.sh" || true
fi

# Substitui o shell pela GUI para que sinais e código de saída sejam propagados corretamente.
exec "$APPROOT/usr/bin/cpu-switch-control" "$@"
